#!/bin/bash
# Softly's app-aware paste for Voxtype. Installed to ~/.local/bin/softly-paste by
# the plugin's Set up (helpers/control.py), which also points Voxtype at it:
#
# Voxtype runs in clipboard mode and calls this as:
#   pre_output_command  = "~/.local/bin/softly-paste save"   (before it copies the transcript)
#   post_output_command = "~/.local/bin/softly-paste paste"  (after it copies the transcript)
#
# Paste follows Omarchy's universal paste rule: Ctrl+V for normal apps,
# Shift+Insert for windows tagged "terminal". Herdr gets Ctrl+Shift+V. Keys go through Hyprland
# send_key_state instead of a virtual keyboard, which Electron apps such as
# MonoCode ignored for Shift+Insert. The transcript stays on the clipboard,
# including when no text field accepts the automatic paste.
#
# Voxtype also runs post_output_command after cancel/no-speech resets; those
# never run "save", so "paste" finds no state and does nothing. A file-output
# recording leaves the clipboard empty after save; the prior contents are
# recovered without sending a paste. Identical consecutive dictations still paste.

set -u

state="${XDG_RUNTIME_DIR:-/tmp}/softly-paste"
# Terminal hosts Omarchy doesn't tag as terminals. Herdr hands Ctrl+V to the CLI
# inside (Codex reads it as "paste an image") and ignores Shift+Insert, but
# pastes text on its own Ctrl+Shift+V.
ctrl_shift_v_apps='["herdr-app"]'


lua_key() {
  hyprctl dispatch "hl.dsp.send_key_state({ mods = \"$1\", key = \"$2\", state = \"$3\" })" 2>&1
}

send_shortcut() {
  local out
  out=$(lua_key "$1" "$2" down)
  if [[ -z $out || $out == ok ]]; then
    sleep 0.05
    lua_key "$1" "$2" up >/dev/null
  else
    hyprctl dispatch sendshortcut "$1,$2," >/dev/null 2>&1
  fi
}

save() {
  rm -rf "$state"
  mkdir -m 700 -p "$state" || exit 0

  local types type=""
  types=$(wl-paste --list-types 2>/dev/null)
  if [[ -n $types ]]; then
    for preferred in "text/plain;charset=utf-8" "text/plain" "image/png"; do
      if grep -qxF "$preferred" <<<"$types"; then type=$preferred; break; fi
    done
    [[ -z $type ]] && type=$(head -n1 <<<"$types")
    wl-paste --no-newline --type "$type" >"$state/clip" 2>/dev/null || type=""
  fi

  printf '%s' "$type" >"$state/type"
  touch "$state/armed"
  # Distinguish new output even when it repeats the previous transcript.
  wl-copy --clear
}

recover_previous() {
  local type
  type=$(<"$state/type")
  if [[ -n $type ]]; then
    # wl-copy stays behind to serve the clipboard; detach it from Voxtype's
    # pipes, or Voxtype waits for this hook forever and the pill never closes.
    wl-copy --type "$type" <"$state/clip" >/dev/null 2>&1
  fi
  rm -rf "$state"
}

# softly-fix leaves this when the dictation ended with a spoken "submit".
submit_flag="${XDG_RUNTIME_DIR:-/tmp}/softly-submit"

press_return_if_asked() {
  [[ -f $submit_flag ]] || return 0
  local fresh
  fresh=$(find "$submit_flag" -mmin -1 2>/dev/null)
  rm -f "$submit_flag"
  [[ -n $fresh ]] || return 0
  sleep 0.12   # let the app take the paste first
  send_shortcut "" Return
}

paste() {
  if [[ ! -f $state/armed ]]; then
    press_return_if_asked   # "submit" on its own: nothing to paste, just Enter
    exit 0
  fi
  # Ignore stale state from an interrupted run.
  if [[ -z $(find "$state/armed" -mmin -1 2>/dev/null) ]]; then rm -rf "$state"; exit 0; fi
  rm -f "$state/armed"

  wl-paste --no-newline --type text/plain >"$state/dictated" 2>/dev/null
  if [[ ! -s $state/dictated ]]; then
    recover_previous   # no clipboard output: recover without pasting
    press_return_if_asked
    exit 0
  fi

  # Whisper was trained partly on video subtitles, so near-silence often comes
  # back as "Thanks for watching!" and the like. A transcript that is nothing
  # but one of these counts as nothing said: no paste, clipboard restored.
  local normalized
  normalized=$(tr '[:upper:]' '[:lower:]' <"$state/dictated" | tr -cd '[:alnum:] ' | tr -s ' ' | sed 's/^ //; s/ $//')
  if [[ $normalized =~ ^(thanks for watching|thanks for watching bye|thank you for watching|thank you so much for watching|thanks for listening|thank you for listening|please subscribe|please like and subscribe|like and subscribe|subscribe to my channel|dont forget to like and subscribe|see you in the next video|see you next time|bye|bye bye|byebye|you|subtitles by the amaraorg community|transcription by castingwords)$ ]]; then
    recover_previous
    exit 0
  fi

  local window
  window=$(hyprctl activewindow -j 2>/dev/null)
  if jq -e --argjson apps "$ctrl_shift_v_apps" '.class as $c | $apps | index($c)' <<<"$window" >/dev/null; then
    send_shortcut "CTRL SHIFT" V
  elif jq -e '(.tags // []) | map(sub("\\*$"; "")) | index("terminal")' <<<"$window" >/dev/null; then
    send_shortcut SHIFT Insert
  else
    send_shortcut CTRL V
  fi
  press_return_if_asked

  # Notify the overlay only after a real transcript was copied; no text is sent.
  omarchy-shell io.github.denonmaryland.softly complete >/dev/null 2>&1 || true
  # Keep the last few dictations for the bar popover (runtime dir only, never on disk).
  python3 -I "$HOME/.config/omarchy/plugins/io.github.denonmaryland.softly/helpers/control.py" remember "$state/dictated" >/dev/null 2>&1 || true

  # Keep dictated text available for Ctrl+V, whether or not paste was accepted.
  rm -rf "$state"
}

case "${1:-}" in
  save) save ;;
  paste) paste ;;
  *) echo "usage: softly-paste save|paste" >&2; exit 2 ;;
esac
exit 0
